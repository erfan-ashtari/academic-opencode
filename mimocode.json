{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent"],
  "model": "mimo/mimo-auto",
  "small_model": "mimo/mimo-auto",
  "default_agent": "sisyphus",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".mimocode/skills"]
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow"
  },
  "mcp": {},
  "experimental": {
    "primary_tools": ["edit", "bash"]
  }
}
