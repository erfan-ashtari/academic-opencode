{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "agents": {
    "sisyphus": {
      "model": "mimo/mimo-auto",
      "temperature": 0.7,
      "permission": { "edit": "allow", "bash": "allow", "webfetch": "allow" }
    },
    "hephaestus": {
      "model": "mimo/mimo-auto",
      "temperature": 0.7
    },
    "prometheus": {
      "model": "mimo/mimo-auto",
      "temperature": 0.7
    },
    "oracle": {
      "model": "mimo/mimo-auto",
      "temperature": 0.7
    },
    "librarian": {
      "model": "mimo/mimo-auto",
    },
    "explore": {
      "model": "mimo/mimo-auto",
    },
    "multimodal-looker": {
      "model": "mimo/mimo-auto",
    },
    "metis": {
      "model": "mimo/mimo-auto",
    },
    "momus": {
      "model": "mimo/mimo-auto",
    },
    "atlas": {
      "model": "mimo/mimo-auto",
    }
  },

  "categories": {
    "quick": { "model": "mimo/mimo-auto" },
    "unspecified-low": { "model": "mimo/mimo-auto" },
    "unspecified-high": { "model": "mimo/mimo-auto" },
    "visual-engineering": { "model": "mimo/mimo-auto" },
    "deep": { "model": "mimo/mimo-auto" },
    "ultrabrain": { "model": "mimo/mimo-auto" },
    "writing": { "model": "mimo/mimo-auto" },
    "artistry": { "model": "mimo/mimo-auto" }
  },

  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_hooks": [],
  "disabled_commands": [],
  "disabled_mcps": [],
  "disabled_tools": [],
  "disabled_providers": [],

  "background_task": {
    "defaultConcurrency": 3,
    "providerConcurrency": { "mimocode": 3 }
  },

  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "tmux_visualization": false
  },

  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 500, 502, 503, 504],
    "max_fallback_attempts": 3,
    "timeout_seconds": 30
  },

  "hashline_edit": true,

  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },

  "skills": {
    "disable": [],
    "sources": [
      { "path": "./.mimocode/skills", "recursive": true }
    ]
  },

  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },

  "comment_checker": {},

  "experimental": {
    "task_system": true,
    "aggressive_truncation": false
  }
}
